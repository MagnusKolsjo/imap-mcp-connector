# =============================================================================
# IMAP MCP Connector — MCP server for any IMAP mailbox
# Configuration template: copy to .env and adjust. Never commit .env to git.
# Accounts themselves are managed in the settings UI (python admin_server.py),
# not in this file. Everything below is optional.
# =============================================================================

# -----------------------------------------------------------------------------
# Account file
# -----------------------------------------------------------------------------
# Where accounts.json lives. When unset, the platform's user config folder is
# used (macOS: ~/Library/Application Support/imap-mcp-connector/accounts.json).
# The file holds host names and permissions, never passwords.
# IMAP_CONNECTOR_CONFIG=/<PATH_TO_CONFIG_FOLDER>/accounts.json

# -----------------------------------------------------------------------------
# Passwords for headless installations
# -----------------------------------------------------------------------------
# On a desktop, passwords are stored in the system keychain by the settings
# UI. Where no keychain exists (a server without a desktop session), give
# them as environment variables instead. <ID> is the account id in upper
# case, as shown in the settings UI.
# IMAP_SECRET_<ID>=<APP_PASSWORD>
# Or point to a file only the service user can read:
# IMAP_SECRET_<ID>_FILE=/<PATH_TO_SECRET_FILE>
# A separate SMTP password, when it differs from the IMAP one:
# IMAP_SECRET_<ID>_SMTP=<APP_PASSWORD>

# -----------------------------------------------------------------------------
# IMAP
# -----------------------------------------------------------------------------
# Network timeout in seconds per IMAP connection.
IMAP_TIMEOUT=30

# Seconds to try reaching the server, shared by all of its addresses. Keeps
# a blocked server (VPN, firewall) from holding a call longer than an MCP
# client waits; the error then says what to check.
IMAP_CONNECT_TIMEOUT=15

# Largest message fetched into memory, in MB. Larger messages are refused
# because MIME cannot be parsed from a fragment.
IMAP_MAX_MESSAGE_MB=25

# Largest image attachment returned to the AI tool, in MB.
IMAP_MAX_IMAGE_MB=5

# Most pages read from one PDF attachment when its text is extracted.
IMAP_PDF_MAX_PAGES=300
# Most messages one organise call (flags, move, trash) may touch. Protects
# against a single mistaken call rearranging a whole mailbox.
IMAP_MAX_BULK=500

# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
# Network timeout in seconds when sending.
SMTP_TIMEOUT=30

# Most recipients (To + Cc + Bcc) per message. A guard against mass mailing.
SMTP_MAX_RECIPIENTS=20

# -----------------------------------------------------------------------------
# Settings UI
# -----------------------------------------------------------------------------
# Port for the local settings UI. Leave unset to pick a free port each time.
# IMAP_ADMIN_PORT=

# Minutes without activity before the settings UI shuts itself down.
IMAP_ADMIN_IDLE_MINUTES=15

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level for stderr. Logs never contain subjects, addresses or bodies.
IMAP_LOG_LEVEL=WARNING

# -----------------------------------------------------------------------------
# MCP transport
# -----------------------------------------------------------------------------
# stdio for an MCP client on the same computer, http for shared
# operation behind a reverse proxy.
MCP_TRANSPORT=stdio

# Address and port in http mode. The server does not encrypt the connection
# itself: keep the address local and let the reverse proxy provide TLS.
MCP_HOST=127.0.0.1
MCP_PORT=8143

# Bearer key, required in http mode: at least 32 characters (startup aborts
# without it or with a shorter one).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=

# -----------------------------------------------------------------------------
# Native dialogs (macOS)
# -----------------------------------------------------------------------------
# Seconds a password or confirmation dialog stays open before it counts as
# cancelled. Long enough to look up a password in a password manager.
IMAP_DIALOG_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# Approval before sending
# -----------------------------------------------------------------------------
# Minutes that "send and don't ask again" allows sending without a question,
# for accounts set to "ask, but let me allow sending for a while".
IMAP_SEND_ALLOW_MINUTES=30

# Language of the approval window when it cannot be read from the system
# (sv, en, or any language with a file in locales/).
# IMAP_UI_LANGUAGE=sv

# -----------------------------------------------------------------------------
# Remote images in the mailbox panel
# -----------------------------------------------------------------------------
# Fetched only when the reader asks, or for trusted senders and domains.
# Largest single image, in KB.
IMAP_IMAGE_MAX_KB=5120

# Most images fetched for one message.
IMAP_IMAGE_MAX_COUNT=40

# Most image data for one message, in MB.
IMAP_IMAGE_MAX_TOTAL_MB=15

# Seconds to wait for one network operation while fetching an image.
IMAP_IMAGE_TIMEOUT=10
# Seconds all images of one message may take together.
IMAP_IMAGE_TOTAL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Saving attachments
# -----------------------------------------------------------------------------
# Largest single attachment that is saved, in MB.
IMAP_ATTACHMENT_MAX_MB=50

# Most data one call may save, in MB. Protects the disk from a mistaken
# request covering a whole mailbox.
IMAP_ATTACHMENT_MAX_TOTAL_MB=500
